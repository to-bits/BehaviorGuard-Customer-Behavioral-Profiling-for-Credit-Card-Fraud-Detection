# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Python packaging and build artifacts
.Python
build/
dist/
wheels/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
share/python-wheels/
MANIFEST

# Virtual environments
.venv/
venv/
env/
env.bak/
.venv.bak/

# Environment files and secrets
.env
.env.*
!.env.example
*.env
*.secret
*.key
*.pem

# Test, coverage, and type-checking output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.ruff_cache/
.pyright/

# Jupyter Notebook output and checkpoints
.ipynb_checkpoints/
*.nbconvert.ipynb

# Local logs and runtime files
*.log
logs/
*.pid
*.pid.lock

# Sensitive and generated datasets
# Keep directory placeholders with data/.gitkeep if needed.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv
*.csv.gz
*.tsv
*.jsonl
*.parquet
*.feather
*.h5
*.hdf5
*.db
*.sqlite
*.sqlite3

# Trained models and generated ML artifacts
# Keep directory placeholders with models/.gitkeep if needed.
models/*
!models/.gitkeep
*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth
*.safetensors

# Frontend dependencies and build output
frontend/node_modules/
frontend/.pnp/
frontend/.pnp.js
frontend/.yarn/
frontend/coverage/
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/
frontend/.cache/
frontend/.vite/
frontend/.env
frontend/.env.*
!frontend/.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker and local service overrides
docker-compose.override.yml
.docker/

# IDE and editor settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
